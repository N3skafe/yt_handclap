<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YouTubeGestureControl" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="materialButtonStyle">@style/Widget.YouTubeGestureControl.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.YouTubeGestureControl.Button.Outlined</item>
    </style>

    <style name="Widget.YouTubeGestureControl.Button" parent="Widget.Material3.Button">
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">4</item>
        <item name="android:ellipsize">none</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
    </style>

    <style name="Widget.YouTubeGestureControl.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">4</item>
        <item name="android:ellipsize">none</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
    </style>
</resources>
